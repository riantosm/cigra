# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# react-native-firebase resolves Firebase via SPM by default, which conflicts with GoogleMaps
# (needed by react-native-maps' Google subspec below) at static-linkage link time — duplicate
# Firebase symbols from RNFBApp/RNFBMessaging each embedding their own SPM copy. Falls back to
# Firebase's plain CocoaPods pods instead, which coexist fine with GoogleMaps' static XCFramework.
$RNFirebaseDisableSPM = true

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'CigraSmartbattalionApps' do
  # Override autolinking's default 'Maps' subspec (Apple Maps only) supaya react-native-maps
  # juga membawa Google Maps SDK — deklarasi manual di sini sebelum use_native_modules! bikin
  # autolinking pakai pod ini apa adanya, bukan nambah pod 'react-native-maps' default lagi.
  pod 'react-native-maps', :subspecs => ['Google'], :path => '../node_modules/react-native-maps'

  # Pod Swift Firebase (FirebaseCoreInternal, FirebaseCrashlytics, FirebaseSessions) butuh module
  # map dari dependency Obj-C ini supaya bisa di-link sebagai static library tanpa use_frameworks!.
  pod 'GoogleUtilities', :modular_headers => true
  pod 'GoogleDataTransport', :modular_headers => true
  pod 'nanopb', :modular_headers => true

  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Xcode 27 menolak deployment target < iOS 15; beberapa pod (bundle privacy/resource Firebase,
    # blob-util, device-info, dll.) masih menyatakan 9.0–13.0. Naikkan ke minimum RN.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        current = build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if current.nil? || Gem::Version.new(current) < Gem::Version.new(min_ios_version_supported)
          build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = min_ios_version_supported
        end
      end
    end
  end
end
