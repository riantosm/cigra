API_BASE_URL=https://api.example.com

# Nama FCM topic yang di-subscribe semua device untuk menerima broadcast push notification
# (dipakai sementara sebelum ada pengiriman per-user/per-device). Boleh diganti bebas asal sama
# antara app dan yang dipakai untuk kirim notifikasi (Firebase Console atau Admin SDK backend).
FCM_TOPIC=all_users

# --- Setup Firebase Cloud Messaging (push notification) ---
# react-native-config hanya mengatur nilai di atas. Push notification sendiri butuh file
# `google-services.json` (BUKAN env var) di `android/app/google-services.json`, didapat dari:
#   1. Buka https://console.firebase.google.com, buat project baru (gratis, cukup akun Google).
#   2. Tambah Android app dengan package name: com.cigrasmartbattalionapps
#   3. Download google-services.json yang diberikan, taruh persis di android/app/google-services.json
#   4. Jalankan ulang `npx react-native run-android` (build otomatis mendeteksi file ini).
# Tanpa file ini, app tetap bisa jalan normal — cuma fitur push notification yang tidak aktif.
#
# Untuk MENGIRIM push (dari backend/Firebase Console), yang dibutuhkan terpisah:
#   - Firebase Console > Project Settings > Service Accounts > "Generate new private key"
#     menghasilkan file JSON kredensial untuk Firebase Admin SDK di sisi backend/server
#     (dipakai untuk request send-message ke FCM, termasuk kirim ke topic FCM_TOPIC di atas).
#   - Atau, untuk tes cepat tanpa kode backend: Firebase Console > Engage > Messaging > buat
#     campaign baru, isi topic "all_users" (atau sesuai FCM_TOPIC), lalu kirim.
#
# Kontrak untuk broadcast panic button (wajib untuk hindari notifikasi dobel di device pengirim):
#   Saat backend menerima POST /panic-buttons dan mem-broadcast FCM ke topic di atas, payload
#   data-nya HARUS menyertakan `panic_button_id` berisi id record panic-button yang sama persis
#   (string). App di device pengirim sudah menampilkan alert local duluan dengan id yang sama,
#   dan akan skip menampilkan ulang kalau FCM masuk dengan panic_button_id yang cocok.
#
# Topic per-role: selain FCM_TOPIC di atas (semua device), tiap device juga subscribe ke satu
# topic per nilai di array `roles` milik user (dari response /auth/login atau /auth/me), misal
# "komandan" atau "anggota". Backend bisa kirim FCM cuma ke topic role tertentu (mis. cuma
# "anggota") supaya hanya device dengan role itu yang menerima — nama topic harus persis sama
# dengan nilai role di response API (case-sensitive).

# --- Setup Google Maps (react-native-maps) ---
# Dari https://console.cloud.google.com/apis/credentials — sebuah project dengan billing aktif dan
# "Maps SDK for Android" + "Maps SDK for iOS" di-enable (https://console.cloud.google.com/apis/library).
# Idealnya 2 key terpisah: satu di-restrict ke Android apps (package name
# com.cigrasmartbattalionapps + SHA-1 debug/release keystore), satu lagi ke iOS apps (bundle
# identifier com.cigrasmartbattalionapps) — 1 key tidak bisa di-restrict ke dua tipe app sekaligus.
# Dipakai otomatis oleh android/app/src/main/AndroidManifest.xml (via @string/MAPS_API_KEY, dari
# react-native-config's resValue) dan ios/CigraSmartbattalionApps/AppDelegate.swift.
MAPS_API_KEY=
